# Copy this file to .env (same folder) and fill it in. Lines starting with # are notes.

# Your site's address: a free name from https://www.duckdns.org (point it at the server's public IP).
# Leave it empty to serve plain http on the IP address (works, but the microphone in Listen mode needs https).
SKYSHIFT_DOMAIN=skyshift.duckdns.org

# How often to check NASA for new SPHEREx releases, in hours (0 = never).
SKYSHIFT_WATCH_HOURS=6

# Optional: full AI answers in "Ask about this object". A free token from https://huggingface.co/settings/tokens
# Without it, the built-in answerer replies from SkyShift's own data.
HF_TOKEN=
# ...or a different AI server (for example a local Ollama): see the main README.
SKYSHIFT_LLM_URL=
SKYSHIFT_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
